page {
  background: #f6f5fa;
  color: #302d43;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
view,
text,
input,
textarea,
button,
picker {
  box-sizing: border-box;
}
.page {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: -1rpx;
  margin: 8rpx 0 14rpx;
}
.subtitle,
.muted {
  color: #736b83;
  font-size: 25rpx;
  line-height: 1.65;
}
.brand {
  color: #7561cf;
  font-size: 25rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.section {
  margin-top: 38rpx;
  margin-bottom: 20rpx;
}
.section-head,
.inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.row-title {
  font-size: 30rpx;
  font-weight: 600;
}
.row,
.panel {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
}
.panel {
  padding: 32rpx;
}
.value {
  color: #6550bc;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
  margin: 12rpx 0;
}
.quantity {
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.2;
}
.unit {
  font-size: 24rpx;
  color: #736b83;
  font-weight: 400;
  margin-left: 8rpx;
}
.notice {
  background: #eeeaf8;
  border-radius: 18rpx;
  color: #655987;
  padding: 22rpx 24rpx;
  margin: 22rpx 0;
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-all;
}
.notice.error {
  background: #fbedea;
  color: #a35445;
}
.empty {
  padding: 52rpx 24rpx;
  text-align: center;
  color: #736b83;
  line-height: 1.9;
  font-size: 26rpx;
}
.empty-title {
  color: #4b455f;
  font-size: 30rpx;
  font-weight: 600;
  margin: 16rpx 0 8rpx;
}
.empty-symbol {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  background: #ece7f8;
  color: #7561cf;
  margin: 0 auto 20rpx;
  font-size: 44rpx;
  line-height: 80rpx;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 24rpx 0;
  align-items: center;
}
.actions button {
  flex: 1;
}
button {
  border: 0;
  border-radius: 18rpx;
  background: #7561cf;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  margin: 0;
  padding: 0 28rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  white-space: nowrap;
}
button::after {
  border: 0;
}
button.secondary {
  background: #eeeaf8;
  color: #6854ba;
}
button.quiet {
  background: transparent;
  color: #7561cf;
}
button.danger {
  background: #f8ecea;
  color: #ab6255;
}
button[size="mini"] {
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
}
button[disabled] {
  background: #e9e6ef;
  color: #a6a0b7;
}
input,
textarea,
picker {
  background: #f7f6fa;
  border: 2rpx solid #eeebf3;
  border-radius: 16rpx;
  margin: 12rpx 0 26rpx;
  width: 100%;
  font-size: 28rpx;
  color: #383149;
}
input {
  height: 92rpx;
  padding: 0 22rpx;
  line-height: normal;
}
textarea,
picker {
  padding: 22rpx;
}
textarea {
  height: 230rpx;
  line-height: 1.65;
}
picker {
  min-height: 90rpx;
}
.label {
  font-size: 27rpx;
  color: #514a65;
  font-weight: 500;
}
.field-help {
  font-size: 23rpx;
  color: #938b9f;
  margin: -12rpx 0 24rpx;
}
.tag {
  display: inline-block;
  background: #f0ecfa;
  color: #7561cf;
  padding: 5rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 400;
}
.link {
  color: #7561cf;
  font-size: 25rpx;
  padding: 14rpx 0;
}
.bar {
  height: 16rpx;
  background: #a394dd;
  border-radius: 8rpx;
  margin: 16rpx 0;
}
.divider {
  height: 2rpx;
  background: #f0edf5;
  margin: 24rpx 0;
}
.form-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 26rpx;
}
.footer-note {
  font-size: 23rpx;
  color: #80778d;
  text-align: center;
  line-height: 1.7;
  padding: 24rpx 12rpx;
}
.search {
  background: #fff;
  border: 0;
  padding-left: 30rpx;
  margin: 24rpx 0;
}
.count-pill {
  font-size: 24rpx;
  color: #90869f;
}
.record-number {
  font-size: 34rpx;
  font-weight: 600;
}
.record-meta {
  font-size: 22rpx;
  color: #a098ab;
  word-break: break-all;
  margin-top: 12rpx;
}
.avatar {
  background: #eae4fa;
  color: #7561cf;
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
  text-align: center;
  line-height: 76rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.grow {
  flex: 1;
  min-width: 0;
}
.wrap {
  word-break: break-all;
}

.row-title, .title { word-break: break-word; }

@import "./app-wxa-auto-dark.wxss";
