.family-heading {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 12rpx 0 32rpx;
}
.family-heading .title {
  font-size: 38rpx;
  margin: 0 0 6rpx;
}
.family-heading .avatar {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 32rpx;
}
.recovery-details {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
}
.invitation-instructions {
  margin-bottom: 18rpx;
}
.invitation-code {
  font-size: 30rpx;
  font-weight: 600;
  word-break: break-all;
}
.invitation-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}
