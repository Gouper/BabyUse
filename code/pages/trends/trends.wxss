.trend-chart {
  display: block;
  width: 100%;
  height: 280px;
}
.chart-panel { margin-top: 24rpx; }
.trend-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}
.trend-tabs button { margin: 0; }
.trend-item-picker { margin-bottom: 0; }
.trend-dates {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.trend-dates picker { margin-bottom: 0; }
.chart-value { color: #8064bd; font-weight: 600; }
.chart-caption { line-height: 1.7; font-size: 23rpx; }
.inferred-point {
  padding: 14rpx 0;
  border-top: 2rpx solid #f0edf5;
  color: #655987;
  font-size: 24rpx;
}
.row .tag { margin: 14rpx 0; }

@media (prefers-color-scheme: dark) {
  .chart-value { color: #bba8ff; }
  .inferred-point {
    border-top-color: #3b3449;
    color: #d3c4ff;
  }
}
