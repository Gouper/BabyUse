.timeline-row {
  position: relative;
  border-left: 4rpx solid #c8baea;
  border-radius: 0 22rpx 22rpx 0;
  margin-left: 10rpx;
}
.timeline-row .row-title {
  margin-bottom: 14rpx;
}
.timeline-row .actions {
  margin: 18rpx 0 0;
}
.timeline-row .muted {
  font-size: 23rpx;
}


@media (prefers-color-scheme: dark) {
  .timeline-row { border-left-color: #8e7abb; }
}
